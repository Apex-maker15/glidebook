# ── Database ─────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ connection string. Free options:
#   • Local, zero-install:  npm run db:local   (PGlite, WASM Postgres on port 5433)
#       DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"
#   • Supabase free tier:   use the *direct* (session, port 5432) connection string so
#       LISTEN/NOTIFY works across serverless instances.
#   • Neon free tier:       works too; realtime automatically falls back to polling+SSE.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres"

# ── Auth (NextAuth.js v5) ─────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_TRUST_HOST="true"

# Public origin of the app (Stripe return URLs). Set to your Vercel URL in production.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Stripe (test mode is free; keys from https://dashboard.stripe.com/test/apikeys) ──
# Leave the placeholders and the app runs fully without payments (holds are still created).
STRIPE_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# From `stripe listen --forward-to localhost:3000/api/webhooks/stripe` (local)
# or the dashboard webhook endpoint (production).
STRIPE_WEBHOOK_SECRET="whsec_..."

# ── Behaviour ─────────────────────────────────────────────────────────────────
# Minutes an unpaid PENDING booking holds its slot before it is released.
BOOKING_HOLD_MINUTES="15"
# Realtime transport: auto (probe Postgres LISTEN/NOTIFY, else in-process), local, or pg.
REALTIME_TRANSPORT="auto"
