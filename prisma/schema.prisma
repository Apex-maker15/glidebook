// GlideBook — deposit-first booking pages for nail techs, beauty pros and other appointment businesses
// All timestamps are stored in UTC. Provider-local rendering uses `User.timezone`.

generator client {
  provider   = "prisma-client-js"
  // Engine-less client (no Rust binary): runs on any CPU/OS and keeps serverless bundles small.
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PROVIDER
  CUSTOMER
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  PAID
}

enum BusinessCategory {
  NAILS_BEAUTY
  HAIR_BARBER
  CAR_DETAILING
  PET_GROOMING
  OTHER
}

// Where the appointment happens.
enum LocationMode {
  STUDIO // clients come to the provider (home studio, salon chair)
  MOBILE // provider travels to the client
}

model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String
  phone        String?
  passwordHash String? // null for guest customers created through the booking flow
  role         Role    @default(CUSTOMER)

  // ── Provider profile (only populated when role = PROVIDER) ──────────────
  businessName        String?
  slug                String?           @unique
  category            BusinessCategory?
  timezone            String            @default("Europe/London")
  currency            String            @default("gbp") // ISO 4217, lowercase (Stripe style)
  locationMode        LocationMode      @default(STUDIO)
  studioAddress       String? // shown to clients when locationMode = STUDIO
  serviceAreas        String? // MOBILE: human-readable coverage, e.g. "Phoenix, Scottsdale, Tempe"
  serviceAreaCodes    String? // MOBILE: comma-separated ZIP/postcode prefixes that are accepted, e.g. "850, 852, 853"
  depositPercent      Int               @default(100) // 100 = full prepayment, e.g. 30 = 30% deposit
  cancelNoticeHours   Int               @default(24) // clients cancelling with more notice than this get their deposit back
  country             String            @default("GB") // ISO 3166-1 alpha-2; fixed once the Stripe account exists

  // ── Stripe Connect (Express) ─────────────────────────────────────────────
  // Deposits are charged on the platform and transferred to this account, minus the platform fee.
  // Until charges are enabled the booking page runs in "no deposit" mode and bookings confirm instantly.
  stripeAccountId        String?   @unique
  stripeAccountLive      Boolean   @default(false) // created with live keys? test-mode accounts are ignored once live keys are in use
  stripeChargesEnabled   Boolean   @default(false)
  stripePayoutsEnabled   Boolean   @default(false)
  stripeDetailsSubmitted Boolean   @default(false)
  stripeConnectedAt      DateTime?
  slotIntervalMinutes Int               @default(30) // granularity of bookable start times
  bufferMinutes       Int               @default(0) // travel / cleanup gap enforced after each job
  minNoticeMinutes    Int               @default(120) // earliest a customer may book ahead of "now"
  bookingHorizonDays  Int               @default(60) // furthest date a customer may book

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  services         Service[]
  availability     Availability[]
  providerBookings Booking[]      @relation("ProviderBookings")
  customerBookings Booking[]      @relation("CustomerBookings")
  setupRequests    SetupRequest[]

  @@index([role])
}

model Service {
  id              String  @id @default(cuid())
  name            String
  description     String?
  durationMinutes Int
  priceCents      Int
  currency        String  @default("gbp")
  active          Boolean @default(true)
  sortOrder       Int     @default(0)

  providerId String
  provider   User   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  bookings Booking[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, active, sortOrder])
}

model Booking {
  id String @id @default(cuid())

  customerId String
  customer   User   @relation("CustomerBookings", fields: [customerId], references: [id])

  providerId String
  provider   User   @relation("ProviderBookings", fields: [providerId], references: [id], onDelete: Cascade)

  serviceId String
  service   Service @relation(fields: [serviceId], references: [id])

  startTime DateTime
  endTime   DateTime
  status    BookingStatus @default(PENDING)

  // Snapshot of price at booking time so later service edits never change what was charged.
  amountCents     Int // full service price
  depositCents    Int // what is actually charged at checkout (== amountCents for full prepay, 0 when no deposit is taken)
  platformFeeCents Int    @default(0) // GlideBook's cut of the deposit (Stripe application fee)
  currency        String  @default("gbp")
  paymentIntentId String? @unique
  paidAt          DateTime?

  // Secret for the client's self-service link (view / cancel) - never exposed to the provider UI.
  manageToken    String    @unique @default(cuid())
  reminderSentAt DateTime?
  cancelledBy    String? // "client" | "provider" | "system"

  // Where the mobile provider travels to, and what they are working on
  // (e.g. "2021 Tesla Model 3, black" or "Biscuit — golden retriever, 30 kg").
  address        String?
  postcode       String? // ZIP / postcode captured for mobile visits (checked against serviceAreaCodes)
  serviceDetails String?
  notes          String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([providerId, startTime])
  @@index([providerId, status])
  @@index([customerId])
}

model Availability {
  id         String @id @default(cuid())
  providerId String
  provider   User   @relation(fields: [providerId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0 = Sunday … 6 = Saturday, in the provider's timezone

  // { "windows": [{ "start": "09:00", "end": "17:00" }], "breaks": [{ "start": "12:00", "end": "13:00" }] }
  slots Json

  @@unique([providerId, dayOfWeek])
}

enum SetupRequestStatus {
  PENDING_PAYMENT
  PAID
  DONE
}

// "Done-for-you" onboarding: a provider pays a small fee and an admin builds their page.
model SetupRequest {
  id         String             @id @default(cuid())
  providerId String
  provider   User               @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status     SetupRequestStatus @default(PENDING_PAYMENT)
  notes      String // what the provider pasted: services, prices, hours, address
  feeCents   Int
  currency   String             @default("gbp")

  paymentIntentId String?   @unique
  paidAt          DateTime?
  completedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
}

// Stripe delivers webhooks at-least-once; this table makes processing idempotent.
model StripeEvent {
  id          String   @id // Stripe event id (evt_…)
  type        String
  processedAt DateTime @default(now())
}
